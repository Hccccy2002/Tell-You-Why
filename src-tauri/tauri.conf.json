{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tell You Why",
  "version": "0.1.0",
  "identifier": "com.tellyouwhy.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Tell You Why",
        "width": 420,
        "height": 560,
        "minWidth": 360,
        "minHeight": 440,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "center": true,
        "focus": false,
        "visible": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "工作电脑上的安静知识小窗",
    "longDescription": "在 30–90 秒里，先勾起好奇，再讲清楚为什么。",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
